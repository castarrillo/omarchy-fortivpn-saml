[Unit]
Description=OpenFortiVPN panel controller
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/local/lib/fortivpn-panel/service.py --uid @UID@
Restart=on-failure
RestartSec=2
RuntimeDirectory=fortivpn-panel
RuntimeDirectoryMode=0755
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=true
PrivateTmp=yes
TimeoutStopSec=20
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
